# Network RPC URL (Base Sepolia Testnet or http://127.0.0.1:8545 for Anvil)
RPC_URL=https://sepolia.base.org

# Optional: Deployment private key (Only needed if deploying a fresh contract to testnet/mainnet)
# For local Anvil testing, defaults automatically to Anvil Account #0.
# PRIVATE_KEY=your_private_key_here
